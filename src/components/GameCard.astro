---
import GameArt from './GameArt.astro';

interface Props {
	game: {
		id: string;
		data: {
			title: string;
			year: number;
			platform: string;
			generation: string;
			genre: string;
			rating: number;
			visual: 'mario' | 'sonic' | 'tetris' | 'street-fighter' | 'donkey-kong' | 'outrun' | 'zelda' | 'chrono-trigger' | 'castlevania';
			palette: string;
		};
	};
	compact?: boolean;
}

const { game, compact = false } = Astro.props;
---

<article
	class:list={['game-card', { 'game-card--compact': compact }]}
	data-game-card
	data-title={game.data.title.toLowerCase()}
	data-platform={game.data.platform.toLowerCase()}
	data-genre={game.data.genre.toLowerCase()}
	data-generation={game.data.generation}
>
	<a class="game-card__link" href={'/juegos/' + game.id + '/'} aria-label={'Ver ficha de ' + game.data.title}>
		<GameArt visual={game.data.visual} palette={game.data.palette} />
		<div class="game-card__body">
			<div class="game-card__meta"><span>{game.data.platform}</span><span>{game.data.year}</span></div>
			<h3>{game.data.title}</h3>
			<div class="game-card__foot"><span>{game.data.genre}</span><span class="game-card__rating"><span aria-hidden="true">✳</span> {game.data.rating.toFixed(1)}</span></div>
		</div>
	</a>
</article>
