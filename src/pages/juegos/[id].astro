---
import { getCollection, render } from 'astro:content';
import GameArt from '../../components/GameArt.astro';
import GameCard from '../../components/GameCard.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
	const games = await getCollection('juegos');
	return games.map((game) => ({ params: { id: game.id }, props: { game } }));
}

const { game } = Astro.props;
const { Content } = await render(game);
const allGames = await getCollection('juegos');
const related = allGames.filter((item) => item.id !== game.id && item.data.genre === game.data.genre).slice(0, 3);
const selectedGames = related.length ? related : allGames.filter((item) => item.id !== game.id).slice(0, 3);
---

<SiteLayout title={game.data.title + ' — Rebobina'} description={game.data.title + ', ficha del archivo Rebobina: ' + game.data.platform + ', ' + game.data.year + '. Explora su género, duración y por qué volver a jugar.'}>
	<div class="detail-shell shell">
		<nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/catalogo/">Catálogo</a><span aria-hidden="true">/</span><span aria-current="page">{game.data.title}</span></nav>
		<section class="detail-hero">
			<div class="detail-hero__art"><GameArt visual={game.data.visual} palette={game.data.palette} large={true} /></div>
			<div class="detail-hero__copy">
				<p class="eyebrow"><span class="status-dot"></span> {game.data.generation} · {game.data.year}</p>
				<h1>{game.data.title}</h1>
				<p class="detail-hero__lede">{game.data.platform} <span aria-hidden="true">/</span> {game.data.genre}</p>
				<div class="detail-hero__rating"><span aria-hidden="true">✳</span><strong>{game.data.rating.toFixed(1)}</strong><span>valoración de ejemplo</span></div>
				<div class="detail-tags">{game.data.tags.map((tag) => <span>{tag}</span>)}</div>
			</div>
		</section>

		<section class="detail-content">
			<article class="prose"><Content /></article>
			<aside class="fact-card" aria-label="Datos del juego">
				<div class="fact-card__top"><span>DATOS DE LA PARTIDA</span><span>R / {game.data.year}</span></div>
				<dl>
					<div><dt>Plataforma</dt><dd>{game.data.platform}</dd></div>
					<div><dt>Género</dt><dd>{game.data.genre}</dd></div>
					<div><dt>Desarrollo</dt><dd>{game.data.developer}</dd></div>
					<div><dt>Edición</dt><dd>{game.data.publisher}</dd></div>
					<div><dt>Jugadores</dt><dd>{game.data.players}</dd></div>
					<div><dt>Duración</dt><dd>{game.data.playtime}</dd></div>
				</dl>
				<p class="fact-card__note">Duración orientativa para una primera partida.</p>
			</aside>
		</section>
	</div>

	{selectedGames.length > 0 && <section class="related-section shell"><div class="section-heading"><div><p class="eyebrow">Continúa la partida</p><h2>Si te gustó este, prueba...</h2></div><a class="text-link" href="/catalogo/">Todo el catálogo <span aria-hidden="true">→</span></a></div><div class="game-grid">{selectedGames.map((item) => <GameCard game={item} compact={true} />)}</div></section>}
</SiteLayout>
