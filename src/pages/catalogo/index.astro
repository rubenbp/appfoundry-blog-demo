---
import { getCollection } from 'astro:content';
import GameCard from '../../components/GameCard.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const games = [...await getCollection('juegos')].sort((a, b) => a.data.title.localeCompare(b.data.title, 'es'));
const genres = [...new Set(games.map((game) => game.data.genre))].sort((a, b) => a.localeCompare(b, 'es'));
const platforms = [...new Set(games.map((game) => game.data.platform))].sort((a, b) => a.localeCompare(b, 'es'));
---

<SiteLayout title="Catálogo — Rebobina" description="Explora videojuegos clásicos por consola, género y época.">
	<section class="catalog-hero shell">
		<div><p class="eyebrow"><span class="status-dot"></span> La biblioteca</p><h1>Elige tu<br /><span>siguiente nivel.</span></h1></div>
		<p>Clásicos que caben en una tarde y aventuras que se quedan contigo años. Encuentra tu próxima partida.</p>
		<div class="catalog-hero__index"><span>ÍNDICE DEL ARCHIVO</span><strong>001—{String(games.length).padStart(3, '0')}</strong><span>ACTUALIZADO CON CARIÑO</span></div>
	</section>

	<section class="catalog-section shell" aria-labelledby="catalog-title">
		<div class="catalog-toolbar">
			<div class="search-wrap">
				<label class="search-label" for="game-search">Busca en el archivo</label>
				<div class="search-field"><span aria-hidden="true">⌕</span><input id="game-search" type="search" placeholder="Un título, una consola…" autocomplete="off" /><kbd>/</kbd></div>
			</div>
			<div class="platform-filter"><label for="platform-filter">Consola</label><select id="platform-filter"><option value="">Todas las consolas</option>{platforms.map((platform) => <option value={platform.toLowerCase()}>{platform}</option>)}</select></div>
		</div>
		<div class="genre-filter" aria-label="Filtrar por género">
			<button class="filter-chip is-selected" type="button" data-genre-filter="" aria-pressed="true">Todo el archivo <span>{games.length}</span></button>
			{genres.map((genre) => <button class="filter-chip" type="button" data-genre-filter={genre.toLowerCase()} aria-pressed="false">{genre}</button>)}
		</div>
		<div class="catalog-results-bar"><h2 id="catalog-title">Juegos para volver</h2><p id="catalog-count" aria-live="polite">{games.length} juegos en el archivo</p></div>
		<div class="game-grid game-grid--catalog" id="game-grid">
			{games.map((game) => <GameCard game={game} />)}
		</div>
		<p class="empty-state" id="empty-state" hidden>No encontramos esa partida. Prueba otro título o filtro.</p>
	</section>

	<section class="catalog-note"><div class="shell"><span class="catalog-note__spark">✳</span><p>Cada ficha guarda lo esencial para elegir bien: de qué va, cuánto dura y con quién jugar.</p><a href="/sobre-rebobina/">Cómo construimos el archivo <span aria-hidden="true">↗</span></a></div></section>

	<script>
		import { filterGames as selectGames } from '../../lib/catalog-filter.mjs';

		const cards = [...document.querySelectorAll('[data-game-card]')];
		const search = document.querySelector('#game-search');
		const platform = document.querySelector('#platform-filter');
		const count = document.querySelector('#catalog-count');
		const empty = document.querySelector('#empty-state');
		const genreButtons = [...document.querySelectorAll('[data-genre-filter]')];
		const games = cards.map((element) => ({
			element,
			title: element.dataset.title,
			platform: element.dataset.platform,
			genre: element.dataset.genre,
			generation: element.dataset.generation,
		}));
		let activeGenre = '';
		let activeGeneration = new URLSearchParams(window.location.search).get('generacion') ?? '';

		function filterGames() {
			const visibleGames = new Set(selectGames(games, {
				query: search.value,
				genre: activeGenre,
				platform: platform.value,
				generation: activeGeneration,
			}).map((game) => game.element));
			cards.forEach((card) => { card.hidden = !visibleGames.has(card); });
			const visible = visibleGames.size;
			count.textContent = visible + (visible === 1 ? ' juego en el archivo' : ' juegos en el archivo');
			empty.hidden = visible !== 0;
		}

		search.addEventListener('input', filterGames);
		platform.addEventListener('change', filterGames);
		genreButtons.forEach((button) => {
			button.addEventListener('click', () => {
				activeGenre = button.dataset.genreFilter;
				genreButtons.forEach((item) => {
					const selected = item === button;
					item.classList.toggle('is-selected', selected);
					item.setAttribute('aria-pressed', String(selected));
				});
				filterGames();
			});
		});

		if (activeGeneration) filterGames();
		window.addEventListener('keydown', (event) => {
			if (event.key === '/' && document.activeElement !== search && !['INPUT', 'SELECT', 'TEXTAREA'].includes(document.activeElement.tagName)) {
				event.preventDefault();
				search.focus();
			}
		});
	</script>
</SiteLayout>
